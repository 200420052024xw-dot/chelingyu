.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.hotline {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.hotline-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hotline-icon image {
  width: 44rpx;
  height: 44rpx;
}

.hotline-info {
  flex: 1;
}

.hotline-title {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text-strong);
}

.hotline-sub {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.hotline-btn {
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-caption);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
  transition: transform var(--motion-fast) var(--ease-out),
              background-color var(--motion-fast) var(--ease-out);
}

.hotline-btn-hover {
  transform: scale(0.96);
  background: var(--color-primary-deep);
}

.linked-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, var(--color-primary-soft), #fff);
  border-radius: 20rpx;
  border: 2rpx solid var(--color-primary-tint);
  animation: fade-in var(--motion-base) var(--ease-out);
}

.linked-info {
  flex: 1;
}

.linked-title {
  font-size: var(--font-caption);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.linked-sub {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
  font-family: monospace;
}

.linked-icon {
  width: 40rpx;
  height: 40rpx;
}

.linked-icon image {
  width: 40rpx;
  height: 40rpx;
}

.section-title {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  padding: 16rpx 32rpx 8rpx;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

.cat {
  flex: 0 0 calc(33.333% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: var(--color-surface-soft);
  transition: all 0.2s;
}

.cat.active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.cat-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.cat-label {
  font-size: var(--font-caption);
}

.card {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.form-label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin: 16rpx 0 8rpx;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  transition: transform var(--motion-fast) var(--ease-out),
              background-color var(--motion-fast) var(--ease-out);
}

.type-chip-hover {
  transform: scale(0.96);
}

.type-chip.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.type-icon {
  width: 28rpx;
  height: 28rpx;
  filter: grayscale(1) brightness(1.8);
}

.type-text {
  font-size: var(--font-caption);
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: var(--font-body);
  box-sizing: border-box;
}

.form-input {
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  font-size: var(--font-body);
}

.form-hint {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
  margin-top: 8rpx;
}

.submit-btn {
  background: var(--color-primary);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: var(--font-body);
  font-weight: 700;
  margin-top: 24rpx;
  transition: transform var(--motion-fast) var(--ease-out),
              background-color var(--motion-fast) var(--ease-out);
}

.submit-btn-hover {
  transform: scale(0.98);
  background: var(--color-primary-deep);
}

.ticket-list {
  padding: 0 24rpx;
}

.ticket {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out);
}

.ticket-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow-card-soft);
}

.ticket-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-cat {
  font-size: var(--font-caption);
  color: var(--color-text-strong);
  font-weight: 600;
}

.ticket-status {
  font-size: var(--font-caption);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.ticket-status.closed {
  background: var(--color-surface-soft);
  color: var(--color-text-muted);
}

.ticket-content {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  margin: 12rpx 0;
  line-height: 1.5;
}

.ticket-time {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}
