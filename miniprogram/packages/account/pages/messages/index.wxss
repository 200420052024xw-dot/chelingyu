.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 0;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid var(--color-divider);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--font-body);
  color: var(--color-text-muted);
  position: relative;
  font-weight: 500;
}

.tab.active {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.action-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.action-link {
  color: var(--color-primary-deep);
}

.list {
  padding: 0 24rpx;
}

.msg-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: var(--shadow-card);
}

.msg-card.read {
  background: var(--color-surface-soft);
}

.msg-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-icon image {
  width: 38rpx;
  height: 38rpx;
}

.msg-info {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  justify-content: space-between;
}

.msg-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.msg-time {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.msg-content {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.msg-unread {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-danger);
  flex-shrink: 0;
  margin-top: 16rpx;
}
