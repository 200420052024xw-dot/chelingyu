<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page">
  <view class="tabs">
    <view class="tab {{activeFilter === 'all' ? 'active' : ''}}" data-key="all" bindtap="onFilter">全部</view>
    <view class="tab {{activeFilter === 'unread' ? 'active' : ''}}" data-key="unread" bindtap="onFilter">未读</view>
    <view class="tab {{activeFilter === 'order' ? 'active' : ''}}" data-key="order" bindtap="onFilter">订单</view>
    <view class="tab {{activeFilter === 'system' ? 'active' : ''}}" data-key="system" bindtap="onFilter">系统</view>
  </view>

  <view class="action-row" wx:if="{{unreadCount > 0}}">
    <view class="action-text">共 {{unreadCount}} 条未读</view>
    <view class="action-link" bindtap="onMarkAll">全部已读</view>
  </view>

  <view class="list">
    <view
      class="msg-card {{item.readAt ? 'read' : ''}} press-scale"
      wx:for="{{filteredMessages}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onJump"
    >
      <view class="msg-icon"><image src="{{fmt.messageIcon(item.type)}}" mode="aspectFit"></image></view>
      <view class="msg-info">
        <view class="msg-head">
          <view class="msg-title">{{item.title}}</view>
          <view class="msg-time">{{fmt.time(item.createdAt)}}</view>
        </view>
        <view class="msg-content ellipsis-2">{{item.content}}</view>
      </view>
      <view class="msg-unread" wx:if="{{!item.readAt}}"></view>
    </view>
  </view>

  <empty-state wx:if="{{filteredMessages.length === 0 && messages.length === 0}}" image="/assets/images/empty-messages.png" title="暂无消息" desc="新订单、支付、状态变更都会在这里提示" />
  <empty-state wx:elif="{{filteredMessages.length === 0}}" image="/assets/images/empty-messages.png" title="此分类下暂无消息" desc="切换其他分类查看" />
</view>
