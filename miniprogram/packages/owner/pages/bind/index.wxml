<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page">
  <view class="header">
    <view class="title">选择要绑定的车辆</view>
    <view class="subtitle">以下车辆可绑定至您的本机账号</view>
  </view>

  <view class="list">
    <view
      class="vehicle-card press-scale"
      hover-class="vehicle-card-hover"
      wx:for="{{vehicles}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onBind"
    >
      <view class="v-head">
        <image class="v-img" src="{{item.model.imageUrl}}" mode="aspectFit" />
        <view class="v-info">
          <view class="v-name">{{item.model.name}} · {{item.vehicleNo}}</view>
          <view class="v-meta-row">
            <text>电量 {{item.batteryPercent}}%</text>
            <text>续航 {{item.remainingRangeMeters / 1000}} km</text>
            <text>载重 {{item.model.maxLoadGrams / 1000}} kg</text>
          </view>
          <view class="v-loc"><image src="/assets/icons/location.png" mode="aspectFit"></image>{{fmt.coordinate(item.location.latitude)}}, {{fmt.coordinate(item.location.longitude)}}</view>
        </view>
      </view>
      <view class="bind-action">
        <text>点击绑定 ›</text>
      </view>
    </view>
  </view>
</view>
