.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

.hero {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin: 16rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}

.quick-btn {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast) var(--ease-out),
              background-color var(--motion-fast) var(--ease-out);
}

.quick-btn:active {
  transform: scale(0.98);
  background: var(--color-primary-tint);
}

.quick-icon {
  width: 48rpx;
  height: 48rpx;
  background: var(--color-primary-soft);
  border-radius: 16rpx;
  padding: 8rpx;
}

.quick-label {
  flex: 1;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.quick-arrow {
  color: var(--color-text-subtle);
  font-size: var(--font-title);
}

.hero-img {
  width: 200rpx;
  height: 200rpx;
  background: var(--color-surface-soft);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.hero-info {
  flex: 1;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-strong);
}

.hero-no {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.hero-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.g-cell {
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 20rpx;
}

.g-cap {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.g-val {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-strong);
  display: block;
  margin-top: 4rpx;
}

.section-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
  margin-bottom: 16rpx;
}

.loc-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-body);
  color: var(--color-text);
}

.loc-primary {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loc-primary image {
  width: 28rpx;
  height: 28rpx;
}

.time-line {
  font-size: var(--font-body);
  color: var(--color-text);
  font-weight: 500;
}

.row-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 0;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
  color: var(--color-primary-deep);
  font-size: var(--font-caption);
}

.row-arrow {
  font-size: 32rpx;
}

.empty-text {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  padding: 16rpx 0;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.task-row:last-of-type {
  border-bottom: none;
}

.task-info {
  flex: 1;
}

.task-no {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  font-family: monospace;
}

.task-route {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  margin-top: 4rpx;
}
