<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page page-bottom-action">
  <view class="header">
    <view class="title">名下车辆</view>
    <view class="subtitle">共 {{vehicles.length}} 辆</view>
  </view>

  <view class="list">
    <view
      class="vehicle-card press-scale"
      wx:for="{{vehicles}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpenDetail"
    >
      <view class="v-head">
        <image class="v-img" src="{{item.model.imageUrl}}" mode="aspectFit" />
        <view class="v-info">
          <view class="v-name">{{item.model.name}} · {{item.vehicleNo}}</view>
          <view class="v-tags">
            <status-badge text="{{item.status === 'available' ? '可用' : item.status}}" tone="{{item.ownerShared ? 'success' : 'warning'}}" />
            <status-badge text="{{item.ownerShared ? '已共享' : '未共享'}}" tone="{{item.ownerShared ? 'success' : 'neutral'}}" />
          </view>
          <view class="v-loc"><image src="/assets/icons/location.png" mode="aspectFit"></image>剩余续航 {{fmt.distance(item.remainingRangeMeters)}}</view>
        </view>
      </view>
      <view class="v-meta">
        <view class="v-cell">
          <text class="v-cap">电量</text>
          <text class="v-val">{{item.batteryPercent}}%</text>
        </view>
        <view class="v-cell">
          <text class="v-cap">续航</text>
          <text class="v-val">{{item.remainingRangeMeters / 1000}} km</text>
        </view>
        <view class="v-cell">
          <text class="v-cap">最大载重</text>
          <text class="v-val">{{item.model.maxLoadGrams / 1000}} kg</text>
        </view>
      </view>
      <view class="v-availability">
        <text class="v-cap">开放时段</text>
        <text class="v-time">{{fmt.ranges(item.rule ? item.rule.ranges : null)}}</text>
      </view>
    </view>
  </view>

  <view class="list" wx:if="{{applications.length}}">
    <view class="vehicle-card" wx:for="{{applications}}" wx:key="id">
      <view class="v-head"><image class="v-img" src="{{item.imageUrl}}" mode="aspectFit"/><view class="v-info"><view class="v-name">{{item.vehicleNo}}</view><view class="v-loc">审核状态：{{item.status === 'pending' ? '待区级审核' : item.status === 'approved' ? '已通过' : '已驳回'}}</view><view class="v-loc" wx:if="{{item.reason}}">处理说明：{{item.reason}}</view></view></view>
    </view>
  </view>

  <view class="list" wx:if="{{formOpen}}">
    <view class="vehicle-card">
      <view class="v-name">提交车辆入驻申请</view>
      <input placeholder="车辆编号（字母、数字或横线）" value="{{vehicleNo}}" bindinput="onVehicleNo"/>
      <picker range="{{modelOptions}}" range-key="name" bindchange="onModelPick"><view class="v-availability">车型：{{modelName || '请选择'}}</view></picker>
      <picker range="{{areaOptions}}" range-key="name" bindchange="onAreaPick"><view class="v-availability">运营区域：{{areaName || '请选择'}}</view></picker>
      <button bindtap="onChoosePhoto">{{imagePath ? '重新选择车辆照片' : '上传车辆照片'}}</button>
      <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" style="width: 240rpx; height: 160rpx"/>
      <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmitApplication">提交审核</button>
      <button bindtap="onCloseForm">取消</button>
    </view>
  </view>

  <view class="bottom-action">
    <button class="btn-primary" bindtap="onBindNew">+ {{formOpen ? '继续填写申请' : '添加车辆'}}</button>
  </view>
</view>
