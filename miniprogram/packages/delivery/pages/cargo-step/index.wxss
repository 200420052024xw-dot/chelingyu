.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

/* stepper */
.stepper {
  display: flex;
  align-items: center;
  padding: 0 0 32rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ECEFF3;
  color: var(--color-text-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.step-num.active {
  background: var(--color-primary);
  color: #fff;
}

.step-num.done {
  background: var(--color-primary);
  color: #fff;
}

.step-label {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.step-label.active {
  color: var(--color-primary-deep);
  font-weight: 600;
}

.step-label.done {
  color: var(--color-primary-deep);
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #ECEFF3;
  margin: 0 16rpx;
  margin-bottom: 28rpx;
}

.step-line.done {
  background: var(--color-primary);
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(14, 55, 42, 0.04);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
  margin-bottom: 16rpx;
}

/* category grid */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cat-item {
  position: relative;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
}

.cat-item.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.cat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #eaf5f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-mark {
  color: #087b55;
  font-size: 34rpx;
  font-weight: 700;
}

.cat-name {
  font-size: var(--font-caption);
  color: var(--color-text);
  text-align: center;
}

.cat-check {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

/* input */
.input-cell {
  position: relative;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.input-cell.small {
  padding: 12rpx 16rpx;
}

.input-cell input {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text-strong);
}

.counter {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}

.ph {
  color: var(--color-text-subtle);
}

.cell-label {
  font-size: var(--font-body);
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.requirement-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.requirement-icon {
  width: 30rpx;
  height: 30rpx;
}

.inline-label {
  margin-bottom: 0;
}

.cell-suffix {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-left: 8rpx;
}

.form-note { margin: -2rpx 4rpx 15rpx; color: #7a8983; font-size: 21rpx; line-height: 1.5; }
.optional { color: #84918c; font-size: 22rpx; font-weight: 400; }
.requirement-mark { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #8b6d42; font-size: 22rpx; font-weight: 700; }
.handling-mark { background: #637c72; }

.form-grid {
  display: flex;
  gap: 16rpx;
}

.form-cell {
  flex: 1;
}

.quantity {
  display: flex;
  align-items: center;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 8rpx 12rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: var(--color-text-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.qty-input {
  flex: 1;
  text-align: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.qty-unit {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-right: 8rpx;
}

.dim-row {
  display: flex;
  gap: 12rpx;
}

/* toggle */
.toggle-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.toggle-info {
  flex: 1;
}

.cell-desc {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.toggle {
  position: relative;
  width: 72rpx;
  height: 40rpx;
  background: #D8DEE5;
  border-radius: 999rpx;
}

.toggle.on {
  background: var(--color-primary);
}

.toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s ease;
}

.toggle.on .toggle-thumb {
  transform: translateX(32rpx);
}

/* handling cell (non-toggleable info card) */
.handling-cell {
  padding: 4rpx 0 8rpx;
}

.handling-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.handling-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.74;
}

.handling-info {
  flex: 1;
}

.handling-banner {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f4f7f5;
  border: 1rpx solid #e8eeeb;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.handling-banner-tag {
  flex: 0 0 auto;
  background: #e3eee8;
  color: #376b54;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.handling-banner-text {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--color-text);
  line-height: 1.5;
}

/* bottom */
.action-row {
  display: flex;
  gap: 16rpx;
}

.prev-btn {
  flex: 0 0 200rpx;
}

.next-btn {
  flex: 1;
}
