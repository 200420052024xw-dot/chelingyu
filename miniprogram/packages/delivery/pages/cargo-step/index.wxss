.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

/* stepper */
.stepper {
  display: flex;
  align-items: center;
  padding: 0 0 32rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ECEFF3;
  color: var(--color-text-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.step-num.active {
  background: var(--color-primary);
  color: #fff;
}

.step-num.done {
  background: var(--color-primary);
  color: #fff;
}

.step-label {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.step-label.active {
  color: var(--color-primary-deep);
  font-weight: 600;
}

.step-label.done {
  color: var(--color-primary-deep);
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #ECEFF3;
  margin: 0 16rpx;
  margin-bottom: 28rpx;
}

.step-line.done {
  background: var(--color-primary);
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(14, 55, 42, 0.04);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
  margin-bottom: 16rpx;
}

/* category grid */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.cat-item {
  box-sizing: border-box;
  min-height: 82rpx;
  background: var(--color-surface-soft);
  border-radius: 14rpx;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid transparent;
}

.cat-item.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.cat-icon { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }

.cat-name {
  font-size: 22rpx;
  color: var(--color-text);
  text-align: center;
  white-space: nowrap;
}

.cat-item.active .cat-name { color: var(--color-primary-deep); font-weight: 600; }

/* input */
.input-cell {
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: block;
}

.input-cell.small {
  padding: 12rpx 16rpx;
}

.description-cell { padding: 18rpx 20rpx; }
.description-input {
  box-sizing: border-box;
  width: 100%;
  height: 112rpx;
  color: var(--color-text-strong);
  font-size: var(--font-body);
  line-height: 1.5;
}

.input-cell input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 44rpx;
  font-size: var(--font-body);
  color: var(--color-text-strong);
}

.ph {
  color: var(--color-text-subtle);
}

.cell-label {
  font-size: var(--font-body);
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.requirement-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.requirement-icon {
  width: 36rpx;
  height: 36rpx;
}

.inline-label {
  margin-bottom: 0;
}

.form-note { margin: -2rpx 4rpx 15rpx; color: #7a8983; font-size: 21rpx; line-height: 1.5; }
.optional { color: #84918c; font-size: 22rpx; font-weight: 400; }

.form-grid {
  display: flex;
  gap: 16rpx;
}

.form-cell {
  flex: 1;
}

.quantity {
  display: flex;
  align-items: center;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  padding: 8rpx 12rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: var(--color-text-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.qty-input {
  flex: 1;
  text-align: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.qty-unit {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-right: 8rpx;
}

.dim-row {
  display: flex;
  gap: 12rpx;
}

.dimension-field { flex: 1; min-width: 0; }
.dimension-label { display: block; margin-bottom: 8rpx; color: var(--color-text-muted); font-size: var(--font-caption); }

/* toggle */
.toggle-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.toggle-info {
  flex: 1;
}

.toggle {
  position: relative;
  width: 72rpx;
  height: 40rpx;
  background: #D8DEE5;
  border-radius: 999rpx;
}

.toggle.on {
  background: var(--color-primary);
}

.toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s ease;
}

.toggle.on .toggle-thumb {
  transform: translateX(32rpx);
}

/* bottom */
.action-row {
  display: flex;
  gap: 16rpx;
}

.prev-btn {
  flex: 0 0 200rpx;
}

.next-btn {
  flex: 1;
}
