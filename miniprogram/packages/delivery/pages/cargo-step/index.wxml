<view class="page page-bottom-action">
  <view class="stepper">
    <view class="step done">
      <view class="step-num done">✓</view>
      <text class="step-label done">填写地址</text>
    </view>
    <view class="step-line done"></view>
    <view class="step active">
      <view class="step-num active">2</view>
      <text class="step-label active">物品信息</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <view class="step-num">3</view>
      <text class="step-label">选择车型</text>
    </view>
  </view>

  <!-- 物品类型 -->
  <view class="card">
    <view class="section-title">物品类型</view>
    <view class="cat-grid">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="cat-item {{category === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onPickCategory"
      >
        <image class="cat-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="cat-name">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 物品名称 / 描述 -->
  <view class="card">
    <view class="section-title">货物描述</view>
    <view class="input-cell description-cell">
      <textarea
        class="description-input"
        placeholder="请填写货物名称、包装方式等关键信息"
        placeholder-class="ph"
        value="{{description}}"
        maxlength="200"
        bindinput="onDescriptionInput"
      ></textarea>
    </view>
  </view>

  <view class="form-note">请填写货物的实际总数量与单件参数，平台据此校验车型承载能力</view>
  <!-- 数量 + 单件重量 -->
  <view class="card">
    <view class="form-grid">
      <view class="form-cell">
        <view class="cell-label">数量</view>
        <view class="quantity">
          <view class="qty-btn" bindtap="onMinus">−</view>
          <input
            class="qty-input"
            type="number"
            value="{{quantity}}"
            bindinput="onQuantityInput"
          />
          <view class="qty-unit">件</view>
          <view class="qty-btn" bindtap="onPlus">+</view>
        </view>
      </view>
      <view class="form-cell">
        <view class="cell-label">单件重量 <text class="optional">（选填·kg）</text></view>
        <view class="input-cell small">
          <input
            placeholder="请输入"
            placeholder-class="ph"
            value="{{unitWeightKg}}"
            type="digit"
            bindinput="onWeightInput"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 体积尺寸 -->
  <view class="card">
    <view class="cell-label">单件外包装尺寸 <text class="optional">（选填·米）</text></view>
    <view class="dim-row">
      <view class="dimension-field">
        <text class="dimension-label">长</text>
        <view class="input-cell small"><input placeholder="请输入" placeholder-class="ph" value="{{lengthMeters}}" type="digit" bindinput="onLengthInput" /></view>
      </view>
      <view class="dimension-field">
        <text class="dimension-label">宽</text>
        <view class="input-cell small"><input placeholder="请输入" placeholder-class="ph" value="{{widthMeters}}" type="digit" bindinput="onWidthInput" /></view>
      </view>
      <view class="dimension-field">
        <text class="dimension-label">高</text>
        <view class="input-cell small"><input placeholder="请输入" placeholder-class="ph" value="{{heightMeters}}" type="digit" bindinput="onHeightInput" /></view>
      </view>
    </view>
  </view>

  <!-- 特殊要求 -->
  <view class="card">
    <view class="toggle-cell" bindtap="onToggleFragile">
      <view class="toggle-info">
        <view class="requirement-title">
          <image class="requirement-icon" src="/assets/icons/tabler/alert-triangle.svg" mode="aspectFit"></image>
          <text class="cell-label inline-label">易碎物品</text>
        </view>
      </view>
      <view class="toggle {{fragile ? 'on' : ''}}">
        <view class="toggle-thumb"></view>
      </view>
    </view>
  </view>

  <view class="bottom-action">
    <view class="action-row">
      <button class="btn-primary outline prev-btn" bindtap="onPrev">上一步</button>
      <button class="btn-primary next-btn" bindtap="onNext">下一步</button>
    </view>
  </view>
</view>
