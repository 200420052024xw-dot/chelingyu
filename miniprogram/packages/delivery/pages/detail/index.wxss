.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.status-banner {
  background: linear-gradient(135deg, #0FB96D 0%, #20B27E 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-icon image {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
}

.status-row-text {
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
}

.status-meta-inline {
  font-size: var(--font-caption);
  opacity: 0.8;
  margin-top: 4rpx;
  font-family: monospace;
}

.status-hint {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  opacity: 0.9;
  line-height: 1.5;
}

/* 步骤进度条 */
.step-strip {
  margin-top: 24rpx;
  padding: 16rpx 0 0;
  display: flex;
  align-items: flex-start;
  position: relative;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 0;
}

.step:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  right: -50%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.35);
  z-index: 0;
}

.step.done:not(:last-child)::after {
  background: #fff;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.step.done .step-dot {
  background: #fff;
  border-color: #fff;
}

.step.current .step-dot {
  background: #fff;
  border-color: #fff;
  animation: pulse var(--motion-slow) var(--ease-in-out) infinite;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.4);
}

.step-dot-check {
  color: var(--color-primary-deep);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.step-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
  white-space: nowrap;
}

.step.done .step-label,
.step.current .step-label {
  color: #fff;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
  margin-bottom: 16rpx;
}

/* 车辆 */
.vehicle-card .vehicle-head {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.vehicle-image {
  width: 128rpx;
  height: 128rpx;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
}

.vehicle-info {
  flex: 1;
}
.vehicle-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.distance-to-user { max-width: 200rpx; text-align: right; font-size: 21rpx; color: #397a57; }
.progress-open-hint { text-align: right; font-size: 22rpx; color: #397a57; padding-top: 12rpx; }
.progress-modal { max-height: 75vh; }
.progress-scroll { max-height: 55vh; margin: 18rpx 0; }

.vehicle-name {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text-strong);
}

.vehicle-no {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.vehicle-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.meta-pill {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: var(--font-caption);
  display: flex;
  gap: 4rpx;
}

/* 地址 */
.address-row {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.address-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.dot-pickup { background: var(--color-pickup); }
.dot-dropoff { background: var(--color-dropoff); }

.address-info {
  flex: 1;
}

.address-label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.address-name {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
  margin-top: 4rpx;
}

.address-detail {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.address-contact {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
  margin-top: 4rpx;
}

.cargo-row {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
}

.cargo-cell {
  flex: 1;
}

.cargo-key {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  display: block;
}

.cargo-val {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-strong);
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 16rpx;
}

.timeline-item {
  position: relative;
  padding-left: 24rpx;
  padding-bottom: 24rpx;
  border-left: 2rpx solid var(--color-divider);
}

.timeline-item.last {
  border-left-color: transparent;
}

.timeline-item.current .timeline-dot {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(15, 185, 109, 0.2);
}

.timeline-dot {
  position: absolute;
  left: -10rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-divider);
}

.timeline-label {
  font-size: var(--font-body);
  color: var(--color-text);
  font-weight: 500;
}

.timeline-time {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* 费用 */
.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-body);
  padding: 8rpx 0;
}

.fee-label {
  color: var(--color-text);
}

.fee-val {
  color: var(--color-text);
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 12rpx 0;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-body);
}

.total-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}

.pay-row {
  margin-top: 16rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: var(--font-body);
}

.kv-key {
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}

.kv-val {
  color: var(--color-text);
}

/* 客服 */
.support-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.support-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 4rpx;
}

.support-text-block {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.support-sub {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 2rpx;
}

.support-text {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text);
}

.support-arrow {
  color: var(--color-text-subtle);
  font-size: 36rpx;
}

/* 底部 */
.action-row {
  display: flex;
  gap: 16rpx;
}

.action-row .btn-primary {
  flex: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 60rpx;
}

.modal {
  background: #fff;
  border-radius: 24rpx;
  width: 100%;
  padding: 32rpx;
}

.modal-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-text-strong);
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-reasons {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.reason {
  padding: 20rpx;
  background: var(--color-surface-soft);
  border-radius: 12rpx;
  font-size: var(--font-body);
  color: var(--color-text);
  border: 2rpx solid transparent;
}

.reason.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
  color: var(--color-primary-deep);
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-actions .btn-primary {
  flex: 1;
}
.route-map { display: block; width: 100%; height: 420rpx; border-radius: 18rpx; overflow: hidden; }
.route-note { color: #7b9588; font-size: 22rpx; margin-top: 14rpx; line-height: 1.5; }
.quote-change { color: #234b36; font-size: 27rpx; margin-top: 12rpx; }
