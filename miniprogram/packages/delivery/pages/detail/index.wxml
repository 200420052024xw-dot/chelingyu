<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page page-bottom-action">
  <block wx:if="{{view}}">
    <!-- 顶部状态 -->
    <view class="status-banner">
      <view class="status-row">
        <view class="status-icon"><image src="{{statusIcon}}" mode="aspectFit"></image></view>
        <view class="status-row-text">
          <view class="status-title">{{statusBadge.text}}</view>
          <view class="status-meta-inline">订单号 {{view.order.orderNo}}</view>
        </view>
        <status-badge text="{{statusBadge.text}}" tone="{{statusBadge.tone}}" />
      </view>
      <view class="status-hint">{{statusHint}}</view>

      <!-- 步骤进度条 -->
      <view class="step-strip" bindtap="onOpenProgress">
        <view
          class="step {{index <= statusStepIndex ? 'done' : ''}} {{index === statusStepIndex && !progressTerminal ? 'current' : ''}}"
          wx:for="{{orderSteps}}"
          wx:key="key"
        >
          <view class="step-dot">
            <view wx:if="{{index < statusStepIndex}}" class="step-dot-check">✓</view>
          </view>
          <view class="step-label">{{item.label}}</view>
        </view>
      </view>
      <view class="progress-open-hint" bindtap="onOpenProgress">点击查看完整订单进度 ›</view>
    </view>

    <!-- 车辆信息（已分配） -->
    <view class="card vehicle-card" wx:if="{{view.assignedVehiclePublic}}">
      <view class="vehicle-head">
        <image class="vehicle-image" src="{{view.assignedVehiclePublic.modelImage}}" mode="aspectFit" />
        <view class="vehicle-info">
          <view class="vehicle-title-row"><view class="vehicle-name">{{view.assignedVehiclePublic.modelName}}</view><view class="distance-to-user">{{distanceLabel}}</view></view>
          <view class="vehicle-no">车辆编号：{{view.assignedVehiclePublic.vehicleNo}}</view>
          <view class="vehicle-meta">
            <view class="meta-pill">
              <text class="meta-pill-label">电量</text>
              <text class="meta-pill-val">{{view.assignedVehiclePublic.batteryPercent}}%</text>
            </view>
            <view class="meta-pill">
              <text class="meta-pill-label">续航</text>
              <text class="meta-pill-val">{{view.assignedVehiclePublic.remainingRangeMeters / 1000}}km</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="card vehicle-card hq-capacity-card" wx:elif="{{view.order.dispatchSource === 'headquarters' || view.order.dispatchSource === 'platform'}}">
      <view class="vehicle-name">{{view.order.vehicleSnapshot.modelName}} · 平台调度</view>
      <view class="vehicle-no">{{view.order.status === 'pending_dispatch_review' || view.order.status === 'pending_headquarters_review' ? '等待调度确认，通过后即可支付。' : view.order.status === 'failed' ? (view.order.dispatchReviewReason || view.order.headquartersReviewReason || '调度未通过') : '正在协调同车型可用车辆。'}}</view>
      <view class="vehicle-no" wx:if="{{scheduledPickupLabel}}">预约时间：{{scheduledPickupLabel}}</view>
    </view>

    <view class="card route-card" wx:if="{{mapVisible}}">
      <view class="section-title">车辆与路线</view>
      <map class="route-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="13" markers="{{mapMarkers}}" polyline="{{mapPolyline}}" show-location="{{false}}"></map>
      <view class="route-note">模拟轨迹 · 车辆位置与路线仅供演示，非实时设备定位</view>
    </view>

    <!-- 地址/货物 -->
    <view class="card">
      <view class="section-title">配送信息</view>
      <view class="address-row">
        <view class="address-dot dot-pickup"></view>
        <view class="address-info">
          <view class="address-label">寄件</view>
          <view class="address-name">{{view.order.sender.name}}</view>
          <view class="address-detail ellipsis-2">{{view.order.sender.detail}}</view>
          <view class="address-contact">{{view.order.sender.contactName}} {{view.order.sender.contactMobile}}</view>
        </view>
      </view>
      <view class="address-row">
        <view class="address-dot dot-dropoff"></view>
        <view class="address-info">
          <view class="address-label">收件</view>
          <view class="address-name">{{view.order.receiver.name}}</view>
          <view class="address-detail ellipsis-2">{{view.order.receiver.detail}}</view>
          <view class="address-contact">{{view.order.receiver.contactName}} {{view.order.receiver.contactMobile}}</view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="cargo-row">
        <view class="cargo-cell">
          <text class="cargo-key">物品</text>
          <text class="cargo-val">{{view.order.cargo.description}}</text>
        </view>
        <view class="cargo-cell">
          <text class="cargo-key">数量</text>
          <text class="cargo-val">{{view.order.cargo.quantity}} 件</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{view.order.routeReviewRequired && view.order.status === 'pending_dispatch_review'}}">
      <view class="section-title">取货区正在核实路线</view>
      <view class="route-note">地图未规划出路线。核实结果、计费里程和报价确认前，无需付款。</view>
    </view>

    <view class="card" wx:if="{{view.order.status === 'pending_customer_quote'}}">
      <view class="section-title">{{view.order.routeReviewEvidence ? '路线已核实，请确认报价' : '平台建议更换车型'}}</view>
      <view class="quote-change">新车型：{{view.order.proposedVehicleModelId}}</view>
      <view class="quote-change" wx:if="{{view.order.proposedRouteDistanceMeters}}">计费里程：{{view.order.proposedRouteDistanceMeters / 1000}} 公里（区级人工核实）</view>
      <view class="quote-change" wx:if="{{view.order.routeReviewEvidence}}">核实依据：{{view.order.routeReviewEvidence}}</view>
      <view class="quote-change">新报价：{{fmt.money(view.order.proposedTotalAmountFen)}}</view>
      <view class="route-note">确认新报价后才会进入支付环节。</view>
    </view>

    <!-- 费用与支付 -->
    <view class="card">
      <view class="section-title">费用明细</view>
      <view class="fee-row" wx:for="{{view.order.priceItems}}" wx:key="type">
        <text class="fee-label">{{item.label}}</text>
        <text class="fee-val">{{fmt.money(item.amountFen)}}</text>
      </view>
      <view class="divider"></view>
      <view class="total-row">
        <text>总计</text>
        <text class="total-val">{{fmt.money(view.order.totalAmountFen)}}</text>
      </view>

      <view class="pay-row" wx:if="{{view.payment}}">
        <view class="kv-row">
          <text class="kv-key">支付方式</text>
          <text class="kv-val">{{view.payment.channel === 'mock' ? '模拟支付' : '微信支付'}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-key">支付状态</text>
          <text class="kv-val">{{view.payment.status === 'succeeded' ? '支付成功' : view.payment.status === 'failed' ? '支付失败' : '待支付'}}</text>
        </view>
      </view>

      <view class="pay-row" wx:if="{{view.refund}}">
        <view class="kv-row">
          <text class="kv-key">退款状态</text>
          <text class="kv-val">{{view.refund.status === 'succeeded' ? '退款成功' : view.refund.status === 'processing' ? '退款处理中' : '退款待处理'}}</text>
        </view>
        <view class="kv-row">
          <text class="kv-key">退款金额</text>
          <text class="kv-val">{{fmt.money(view.refund.amountFen)}}</text>
        </view>
      </view>
    </view>

    <!-- 联系客服 -->
    <view class="card support-card press-scale" bindtap="onCallSupport">
      <view class="support-row">
        <image class="support-icon" src="/assets/icons/chat.png" mode="aspectFit" />
        <view class="support-text-block">
          <text class="support-text">联系客服</text>
          <text class="support-sub">订单问题可一键关联工单</text>
        </view>
        <text class="support-arrow">›</text>
      </view>
    </view>

    <view class="bottom-action" wx:if="{{view.allowedActions.length > 0}}">
      <view class="action-row">
        <button
          class="btn-primary outline"
          wx:if="{{fmt.has(view.allowedActions, 'cancel')}}"
          bindtap="onOpenCancel"
        >取消订单</button>
        <button
          class="btn-primary"
          wx:if="{{fmt.has(view.allowedActions, 'pay') || fmt.has(view.allowedActions, 'retry_pay')}}"
          bindtap="onRetryPay"
          disabled="{{payProcessing}}"
        >{{fmt.has(view.allowedActions, 'retry_pay') ? '重新支付' : '去支付'}}</button>
        <button class="btn-primary" wx:if="{{fmt.has(view.allowedActions, 'accept_quote')}}" bindtap="onAcceptQuote">确认新报价</button>
        <button class="btn-primary" wx:if="{{fmt.has(view.allowedActions, 'confirm_loaded')}}" bindtap="onConfirmLoaded">确认装货</button>
        <button class="btn-primary" wx:if="{{fmt.has(view.allowedActions, 'confirm_received')}}" bindtap="onConfirmReceived">确认收货</button>
      </view>
    </view>
  </block>

  <view class="modal-mask" wx:if="{{progressOpen}}" bindtap="onCloseProgress">
    <view class="modal progress-modal" catchtap=""><view class="modal-title">订单完整进度</view><scroll-view scroll-y="{{true}}" class="progress-scroll"><view class="timeline"><view class="timeline-item {{index === 0 ? 'first' : ''}} {{item.isCurrent ? 'current' : ''}}" wx:for="{{timeline}}" wx:key="occurredAt"><view class="timeline-dot"></view><view class="timeline-content"><view class="timeline-label">{{item.label}}</view><view class="timeline-time">{{item.time}}</view><view class="timeline-time" wx:if="{{item.note}}">{{item.note}}</view></view></view></view></scroll-view><button class="btn-primary" bindtap="onCloseProgress">关闭</button></view>
  </view>

  <!-- 取消弹窗 -->
  <view class="modal-mask" wx:if="{{cancelModalOpen}}" bindtap="onCloseCancel">
    <view class="modal" catchtap="">
      <view class="modal-title">取消订单</view>
      <view class="modal-reasons">
        <view
          class="reason {{cancelReason === item.value ? 'active' : ''}}"
          wx:for="{{cancelReasons}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onPickCancelReason"
        >{{item.label}}</view>
      </view>
      <view class="modal-actions">
        <button class="btn-primary outline" bindtap="onCloseCancel">暂不取消</button>
        <button class="btn-primary" bindtap="onConfirmCancel">确认取消</button>
      </view>
    </view>
  </view>
</view>
