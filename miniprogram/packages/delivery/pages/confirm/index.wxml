<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page page-bottom-action">
  <!-- 寄收件地址 -->
  <view class="card address-card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/tabler/route.svg" mode="aspectFit"></image>
        <text>寄收件地址</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditAddress">修改</view>
    </view>
    <view class="address-row press-scale" hover-class="address-row-hover" data-role="sender" bindtap="onPickAddress">
      <view class="address-icon-wrap pickup-icon-wrap">
        <image class="address-icon" src="/assets/icons/tabler/package-export.svg" mode="aspectFit"></image>
      </view>
      <view class="address-info">
        <view class="address-label">寄件地址</view>
        <view class="address-contact"><text class="contact-name">{{draft.sender.contactName}}</text><text class="contact-phone">{{draft.sender.contactMobile}}</text></view>
        <view class="address-name">{{draft.sender.name}}</view>
        <view class="address-detail">{{draft.sender.detail}}</view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover">›</view>
    </view>
    <view class="address-row press-scale" hover-class="address-row-hover" data-role="receiver" bindtap="onPickAddress">
      <view class="address-icon-wrap dropoff-icon-wrap">
        <image class="address-icon" src="/assets/icons/tabler/map-pin.svg" mode="aspectFit"></image>
      </view>
      <view class="address-info">
        <view class="address-label">收件地址</view>
        <view class="address-contact"><text class="contact-name">{{draft.receiver.contactName}}</text><text class="contact-phone">{{draft.receiver.contactMobile}}</text></view>
        <view class="address-name">{{draft.receiver.name}}</view>
        <view class="address-detail">{{draft.receiver.detail}}</view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover">›</view>
    </view>
  </view>

  <!-- 物品信息 -->
  <view class="card cargo-card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon cargo" src="/assets/icons/tabler/package.svg" mode="aspectFit"></image>
        <text>物品信息</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditCargo">修改</view>
    </view>
    <view class="kv-row"><text class="kv-key">物品类型</text><text class="kv-val">{{cargoCategoryLabel}}</text></view>
    <view class="kv-row"><text class="kv-key">物品名称 / 描述</text><text class="kv-val">{{draft.cargo.description}}</text></view>
    <view class="kv-row"><text class="kv-key">数量</text><text class="kv-val">{{draft.cargo.quantity}} 件</text></view>
    <view class="kv-row" wx:if="{{draft.cargo.unitWeightGrams !== undefined}}"><text class="kv-key">单件重量</text><text class="kv-val">{{weightLabel}}</text></view>
    <view class="kv-row" wx:if="{{draft.cargo.unitDimensionsMm}}"><text class="kv-key">单件尺寸</text><text class="kv-val">{{dimLabel}}</text></view>
    <view class="kv-row"><text class="kv-key">特殊要求</text><text class="kv-val">{{specialLabel}}</text></view>
  </view>

  <!-- 用车信息 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/tabler/truck-delivery.svg" mode="aspectFit"></image>
        <text>用车信息</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditModel">修改</view>
    </view>
    <view class="vehicle-row press-scale" hover-class="vehicle-row-hover">
      <image class="vehicle-image" src="{{vehicleImage}}" mode="aspectFit" />
      <view class="vehicle-info">
        <view class="vehicle-name">{{modelName}}</view>
        <view class="vehicle-tags">
          <text class="tag" wx:for="{{modelTags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="vehicle-meta">
          <view class="meta-item">
            <text>{{modelMaxLoad}} 最大载重</text>
          </view>
          <view class="meta-item">
            <text>{{modelVolume}} 货箱容积</text>
          </view>
          <view class="meta-item" wx:if="{{draft.dispatchSource === 'nearby'}}">
            <text>{{modelBattery}} 当前电量</text>
          </view>
        </view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover" catchtap="onEditModel">›</view>
    </view>
  </view>

  <!-- 用车时间 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon time" src="/assets/icons/tabler/clock-hour-4.svg" mode="aspectFit"></image>
        <text>用车时间</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditTime">修改</view>
    </view>
    <view class="time-row press-scale {{draft.serviceTimeMode === 'scheduled' ? 'scheduled' : ''}}" hover-class="time-row-hover">
      <text class="time-mode">{{draft.serviceTimeMode === 'immediate' ? '立即用车' : '预约用车 · ' + scheduledLabel}}</text>
      <text wx:if="{{draft.dispatchSource === 'headquarters' || draft.dispatchSource === 'platform'}}" class="time-estimate">需平台调度确认</text>
      <text wx:else class="time-estimate">预计 <text class="text-primary">{{quote.estimatedArrivalMinutes}}</text> 分钟内到达</text>
      <view class="address-arrow">›</view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/tabler/file-text.svg" mode="aspectFit"></image>
        <text>费用明细</text>
      </view>
    </view>
    <view class="fee-row" wx:for="{{quote.items}}" wx:key="type">
      <text class="fee-label">{{item.label}}</text>
      <text class="fee-val">{{fmt.money(item.amountFen)}}</text>
    </view>
    <view class="divider"></view>
    <view class="total-row">
      <text>预计费用</text>
      <text class="total-val">{{fmt.money(quote.totalAmountFen)}}</text>
    </view>
  </view>

  <view class="bottom-action">
    <view class="pay-bar">
      <view class="pay-info">
        <view class="pay-label">预计费用</view>
        <view class="pay-price">{{fmt.money(quote.totalAmountFen)}}</view>
      </view>
      <button class="btn-primary pay-btn" bindtap="onSubmitOrder" disabled="{{submitting}}">
        <text wx:if="{{submitting}}">提交中…</text>
        <text wx:else>{{draft.dispatchSource === 'headquarters' || draft.dispatchSource === 'platform' ? '提交平台调度确认' : '确认下单并支付'}}</text>
      </button>
    </view>
  </view>

  <!-- 支付弹窗 -->
  <view class="pay-mask" wx:if="{{payModalOpen}}">
    <view class="pay-modal">
      <view class="pay-modal-header">
        <text>模拟支付</text>
        <text class="pay-close" bindtap="onClosePay">×</text>
      </view>
      <view class="pay-modal-body">
        <view class="pay-amount">{{fmt.money(quote.totalAmountFen)}}</view>
        <view class="pay-hint">本地模拟支付，结果由您选择。关闭后可在订单详情继续支付。</view>
      </view>
      <view class="pay-modal-actions">
        <button class="btn-primary pay-success" bindtap="onSimulateSuccess" disabled="{{payProcessing}}">模拟支付成功</button>
        <button class="btn-primary outline" bindtap="onSimulateFail" disabled="{{payProcessing}}">模拟支付失败</button>
      </view>
      <view wx:if="{{payProcessing}}" class="pay-loading">
        <view class="loading-spinner"></view>
        <text>支付处理中…</text>
      </view>
    </view>
  </view>
</view>
