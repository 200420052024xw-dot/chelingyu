<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page page-bottom-action">
  <!-- 寄收件地址 -->
  <view class="card address-card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/route.png" mode="aspectFit"></image>
        <text>寄收件地址</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditAddress">修改</view>
    </view>
    <view class="address-row press-scale" hover-class="address-row-hover">
      <view class="address-dot dot-pickup"></view>
      <view class="address-info">
        <view class="address-label">寄件地址</view>
        <view class="address-name ellipsis">{{draft.sender.name}}</view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover" catchtap="onEditAddress">›</view>
    </view>
    <view class="address-row press-scale" hover-class="address-row-hover">
      <view class="address-dot dot-dropoff"></view>
      <view class="address-info">
        <view class="address-label">收件地址</view>
        <view class="address-name ellipsis">{{draft.receiver.name}}</view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover" catchtap="onEditAddress">›</view>
    </view>
  </view>

  <!-- 物品信息 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon cargo" src="/assets/icons/box.png" mode="aspectFit"></image>
        <text>物品信息</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditCargo">修改</view>
    </view>
    <view class="kv-row">
      <text class="kv-key">物品类型</text>
      <text class="kv-val">{{cargoCategoryLabel}}</text>
    </view>
    <view class="kv-row">
      <text class="kv-key">物品名称 / 描述</text>
      <text class="kv-val">{{draft.cargo.description}}</text>
    </view>
    <view class="kv-row">
      <text class="kv-key">数量</text>
      <text class="kv-val">{{draft.cargo.quantity}} 件</text>
    </view>
    <view class="kv-row" wx:if="{{draft.cargo.unitWeightGrams !== undefined}}">
      <text class="kv-key">单件重量</text>
      <text class="kv-val">{{weightLabel}}</text>
    </view>
    <view class="kv-row" wx:if="{{draft.cargo.unitDimensionsMm}}">
      <text class="kv-key">单件尺寸</text>
      <text class="kv-val">{{dimLabel}}</text>
    </view>
    <view class="kv-row">
      <text class="kv-key">特殊要求</text>
      <text class="kv-val">{{specialLabel}}</text>
    </view>
  </view>

  <!-- 用车信息 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/vehicle.png" mode="aspectFit"></image>
        <text>用车信息</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditModel">修改</view>
    </view>
    <view class="vehicle-row press-scale" hover-class="vehicle-row-hover">
      <image class="vehicle-image" src="{{vehicleImage}}" mode="aspectFit" />
      <view class="vehicle-info">
        <view class="vehicle-name">{{modelName}}</view>
        <view class="vehicle-tags">
          <text class="tag" wx:for="{{modelTags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="vehicle-meta">
          <view class="meta-item">
            <image class="meta-icon" src="/assets/icons/weight.png" mode="aspectFit" />
            <text>{{modelMaxLoad}} 最大载重</text>
          </view>
          <view class="meta-item">
            <image class="meta-icon" src="/assets/icons/box.png" mode="aspectFit" />
            <text>{{modelVolume}} 货箱容积</text>
          </view>
          <view class="meta-item">
            <image class="meta-icon" src="/assets/icons/battery.png" mode="aspectFit" />
            <text>{{modelBattery}} 当前电量</text>
          </view>
        </view>
      </view>
      <view class="address-arrow press-scale" hover-class="address-arrow-hover" catchtap="onEditModel">›</view>
    </view>
  </view>

  <!-- 用车时间 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon time" src="/assets/icons/clock.png" mode="aspectFit"></image>
        <text>用车时间</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onEditTime">修改</view>
    </view>
    <view class="time-row press-scale" hover-class="time-row-hover">
      <text class="time-mode">{{draft.serviceTimeMode === 'immediate' ? '立即用车' : '预约用车'}}</text>
      <text wx:if="{{draft.dispatchSource === 'headquarters'}}" class="time-estimate">总部调车时间以确认后的调度联系为准</text>
      <text wx:else class="time-estimate">预计 <text class="text-primary">{{quote.estimatedArrivalMinutes}}</text> 分钟内到达</text>
      <view class="address-arrow">›</view>
    </view>
  </view>

  <!-- 费用明细（展开/折叠由底部 pay-toggle 控制） -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">
        <image class="title-icon" src="/assets/icons/money.png" mode="aspectFit"></image>
        <text>费用明细</text>
      </view>
      <view class="edit-link press-scale" hover-class="edit-link-hover" bindtap="onExpandToggle">
        <text>{{expand ? '收起' : '展开'}}</text>
        <text class="caret {{expand ? 'open' : ''}}">▾</text>
      </view>
    </view>
    <block wx:if="{{expand}}">
      <view class="fee-row" wx:for="{{quote.items}}" wx:key="type">
        <text class="fee-label">{{item.label}}</text>
        <text class="fee-val">{{fmt.money(item.amountFen)}}</text>
      </view>
      <view class="divider"></view>
    </block>
    <view class="total-row">
      <text>预计费用</text>
      <text class="total-val">{{fmt.money(quote.totalAmountFen)}}</text>
    </view>
  </view>

  <view class="bottom-action">
    <view class="pay-bar">
      <view class="pay-info">
        <view class="pay-price">{{fmt.money(quote.totalAmountFen)}}</view>
        <view class="pay-toggle press-scale" hover-class="pay-toggle-hover" bindtap="onExpandToggle">
          <text>{{expand ? '收起明细' : '展开明细'}}</text>
          <text class="caret {{expand ? 'open' : ''}}">▾</text>
        </view>
      </view>
      <button wx:if="{{draft.dispatchSource === 'headquarters' && !headquartersConfirmed}}" class="btn-primary pay-btn" bindtap="onConfirmHeadquarters">先确认总部运力</button>
      <button wx:else class="btn-primary pay-btn" bindtap="onConfirmAndPay" disabled="{{submitting}}">
        <text wx:if="{{submitting}}">提交中…</text>
        <text wx:else>确认下单并支付</text>
      </button>
    </view>
  </view>

  <!-- 支付弹窗 -->
  <view class="pay-mask" wx:if="{{payModalOpen}}">
    <view class="pay-modal">
      <view class="pay-modal-header">
        <text>模拟支付</text>
        <text class="pay-close" bindtap="onClosePay">×</text>
      </view>
      <view class="pay-modal-body">
        <view class="pay-amount">{{fmt.money(quote.totalAmountFen)}}</view>
        <view class="pay-hint">本地模拟支付，结果由您选择。关闭后可在订单详情继续支付。</view>
      </view>
      <view class="pay-modal-actions">
        <button class="btn-primary pay-success" bindtap="onSimulateSuccess" disabled="{{payProcessing}}">模拟支付成功</button>
        <button class="btn-primary outline" bindtap="onSimulateFail" disabled="{{payProcessing}}">模拟支付失败</button>
      </view>
      <view wx:if="{{payProcessing}}" class="pay-loading">
        <view class="loading-spinner"></view>
        <text>支付处理中…</text>
      </view>
    </view>
  </view>
</view>
