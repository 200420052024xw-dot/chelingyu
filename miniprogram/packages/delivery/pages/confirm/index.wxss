.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(14, 55, 42, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.title-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.9;
}

.edit-link {
  font-size: var(--font-caption);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  transition: transform var(--motion-fast) var(--ease-out),
              background-color var(--motion-fast) var(--ease-out);
}

.edit-link-hover {
  transform: scale(0.94);
  background: var(--color-primary-tint);
}

/* 地址 */
.address-card .address-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: background-color var(--motion-fast) var(--ease-out);
}

.address-row-hover {
  background: var(--color-surface-soft);
}

.vehicle-row-hover {
  background: var(--color-surface-soft);
}

.time-row-hover {
  background: var(--color-surface-soft);
}

.address-card .address-row + .address-row {
  border-top: 1rpx solid var(--color-divider);
}

.address-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
}

.pickup-icon-wrap { background: #EAF8F0; border-color: #D4F0E0; }
.dropoff-icon-wrap { background: #FFF1EC; border-color: #FFE0D5; }
.address-icon { width: 42rpx; height: 42rpx; }

.address-info {
  flex: 1;
  min-width: 0;
}

.address-label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.address-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-strong);
  margin-top: 8rpx;
}
.address-contact {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 16rpx;
  margin-top: 4rpx;
  color: var(--color-text-strong);
}
.contact-name { font-size: 30rpx; font-weight: 600; }
.contact-phone { font-size: 26rpx; font-weight: 500; }
.address-detail {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.45;
}

.address-arrow {
  font-size: 40rpx;
  color: var(--color-text-subtle);
  transition: color var(--motion-fast) var(--ease-out);
}

.address-arrow-hover {
  color: var(--color-primary);
}

/* 物品信息 */
.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0;
  font-size: var(--font-body);
}
.kv-key {
  flex: 0 0 auto;
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}
.kv-val {
  flex: 1;
  min-width: 0;
  color: var(--color-text-strong);
  font-size: var(--font-body);
  font-weight: 500;
  text-align: right;
  overflow-wrap: anywhere;
}

/* 用车 */
.vehicle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vehicle-image {
  width: 128rpx;
  height: 128rpx;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.vehicle-info {
  flex: 1;
}

.vehicle-name {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text-strong);
}

.vehicle-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 4rpx;
}

.tag {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-caption);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.vehicle-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

/* 时间 */
.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.time-row.scheduled { flex-wrap: wrap; }
.time-row.scheduled .time-mode { width: 100%; }

.time-mode {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.time-estimate {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  flex: 1;
}

/* 费用 */
.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-body);
  padding: 12rpx 0;
}

.fee-label {
  color: var(--color-text);
}

.fee-val {
  color: var(--color-text);
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 12rpx 0;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-body);
  color: var(--color-text);
}

.info-icon {
  color: var(--color-text-subtle);
  margin-left: 4rpx;
}

.total-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}

/* 底部支付 */
.pay-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pay-info {
  flex: 1;
}

.pay-label { font-size: 22rpx; color: var(--color-text-muted); }

.pay-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}

.pay-btn[disabled] {
  opacity: 0.6;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  box-shadow: none;
}

.pay-btn::after {
  border: none;
}

.loading-spinner {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--color-primary-soft);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin 0.8s linear infinite;
  vertical-align: middle;
}

.pay-btn {
  width: 320rpx;
  height: 96rpx;
  border-radius: 48rpx;
}

/* 支付弹窗 */
.pay-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 99;
}

.pay-modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + var(--safe-bottom));
}

.pay-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.pay-close {
  font-size: 40rpx;
  color: var(--color-text-subtle);
}

.pay-modal-body {
  padding: 32rpx 0;
  text-align: center;
}

.pay-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}

.pay-hint {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.pay-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pay-success {
  flex: 2;
}

.pay-modal-actions .btn-primary.outline {
  flex: 1;
}

.pay-loading {
  text-align: center;
  margin-top: 16rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.loading-spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary-soft);
  border-top-color: var(--color-primary);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
