.detail-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(44rpx + var(--safe-bottom)); background: #f5f9f7; }
.vehicle-hero { position: relative; overflow: hidden; padding: 24rpx 28rpx 32rpx; border-radius: 32rpx; background: linear-gradient(155deg, #e6f8ee, #ffffff 72%); text-align: center; }
.hero-image { width: 330rpx; height: 260rpx; margin-top: 22rpx; }
.model-code { color: #0ba774; font-size: 21rpx; font-weight: 700; }
.model-name { margin-top: 5rpx; color: #152d3e; font-size: 36rpx; font-weight: 750; }
.model-description { margin-top: 12rpx; color: #6b7f82; font-size: 23rpx; line-height: 1.5; }
.detail-card { margin-top: 20rpx; padding: 28rpx; border-radius: 28rpx; background: #fff; }
.section-title { margin-bottom: 10rpx; color: #172e40; font-size: 29rpx; font-weight: 700; }
.detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf2ef; color: #75868a; font-size: 23rpx; }
.detail-row text:last-child { color: #203a42; text-align: right; }
.detail-row .active-value { color: #079e69 !important; font-weight: 700; }
.spec-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.spec-item { box-sizing: border-box; width: calc(50% - 8rpx); min-height: 116rpx; padding: 20rpx; border-radius: 20rpx; background: #f2f8f5; }
.spec-label { color: #718580; font-size: 22rpx; }
.spec-value { margin-top: 12rpx; color: #183144; font-size: 28rpx; font-weight: 700; }
.spec-wide { margin-top: 16rpx; padding: 20rpx; border-radius: 20rpx; background: #f2f8f5; }
.spec-cold { background: #ebf8f6; }
.spec-cold .spec-value { color: #078e69; }
.vehicle-map { width: 100%; height: 300rpx; margin-top: 22rpx; border-radius: 20rpx; overflow: hidden; }
.order-button { display: flex; align-items: center; justify-content: center; height: 94rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #08ae75; font-size: 30rpx; font-weight: 700; }
.missing { padding: 100rpx 50rpx; color: #748581; font-size: 26rpx; text-align: center; }
