<view class="detail-page" wx:if="{{found}}">
  <view class="vehicle-hero">
    <image class="hero-image" src="{{modelImage}}" mode="aspectFit"></image>
    <view class="model-code">{{modelCode}}</view>
    <view class="model-name">{{modelName}}</view>
    <view class="model-description">{{description}}</view>
  </view>

  <view class="detail-card">
    <view class="section-title">服务与位置</view>
    <view class="detail-row"><text>车辆状态</text><text class="active-value">{{status}}</text></view>
    <view class="detail-row"><text>预计可达</text><text>约 {{etaMinutes}} 分钟</text></view>
    <view class="detail-row"><text>相对位置</text><text>{{locationText}}</text></view>
    <view class="detail-row"><text>当前电量</text><text class="active-value">{{batteryPercent}}%</text></view>
    <map class="vehicle-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="16" markers="{{markers}}" enable-scroll="{{false}}" enable-zoom="{{false}}"></map>
  </view>

  <view class="detail-card">
    <view class="section-title">车型参数</view>
    <view class="spec-grid">
      <view class="spec-item"><view class="spec-label">额定载重</view><view class="spec-value">{{loadText}}</view></view>
      <view class="spec-item"><view class="spec-label">货厢容积</view><view class="spec-value">{{volumeText}}</view></view>
      <view class="spec-item"><view class="spec-label">最大续航</view><view class="spec-value">{{rangeText}}</view></view>
      <view class="spec-item"><view class="spec-label">运行时速</view><view class="spec-value">{{speedText}}</view></view>
    </view>
    <view class="spec-wide"><view class="spec-label">货箱尺寸（参考）</view><view class="spec-value">{{sizeText}}</view></view>
    <view class="spec-wide spec-cold" wx:if="{{temperatureText}}"><view class="spec-label">冷藏温度</view><view class="spec-value">{{temperatureText}}</view></view>
  </view>

  <button class="order-button" bindtap="onStartOrder">我要用车</button>
</view>
<view class="missing" wx:else>车辆信息已更新，请返回首页重新查看。</view>
