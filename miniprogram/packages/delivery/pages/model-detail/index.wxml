<view class="page" wx:if="{{found}}">
  <view class="hero">
    <image class="hero-image" src="{{image}}" mode="aspectFit" />
    <text class="code">{{code}}</text>
    <view class="name">{{name}}</view>
    <view class="description">{{description}}</view>
  </view>
  <view class="card">
    <view class="title">车型参数</view>
    <view class="spec-grid">
      <view class="spec"><text class="label">最大载重</text><text class="value">{{load}}</text></view>
      <view class="spec"><text class="label">装载容积</text><text class="value">{{volume}}</text></view>
      <view class="spec"><text class="label">最大续航</text><text class="value">{{range}}</text></view>
      <view class="spec"><text class="label">运行时速</text><text class="value">{{speed}}</text></view>
    </view>
    <view class="size-row"><text class="label">长 × 宽 × 高</text><text class="value">{{dimensions}}</text></view>
    <view class="size-row" wx:if="{{temperature}}"><text class="label">冷藏温度</text><text class="value">{{temperature}}</text></view>
  </view>
</view>
<view class="missing" wx:else>车型信息已更新，请返回重新选择。</view>
