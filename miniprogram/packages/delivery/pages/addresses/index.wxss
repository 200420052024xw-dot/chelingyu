.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.addr-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out);
}

.addr-card-hover {
  transform: scale(0.99);
  box-shadow: var(--shadow-elev);
}

.addr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.addr-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.addr-tag {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-caption);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.addr-edit {
  font-size: var(--font-caption);
  color: var(--color-primary-deep);
}

.addr-detail {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin: 8rpx 0;
}

.addr-contact {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}

.addr-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}

.addr-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: background-color var(--motion-fast) var(--ease-out);
}

.addr-action-hover {
  background: var(--color-surface-soft);
}

.addr-action.on {
  color: var(--color-primary-deep);
}

.check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #D8DEE5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: transparent;
}

.check.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
