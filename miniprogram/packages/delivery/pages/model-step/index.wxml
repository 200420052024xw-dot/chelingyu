<wxs module="fmt" src="../../../../utils/format.wxs"></wxs>
<view class="page page-bottom-action">
  <view class="stepper">
    <view class="step done">
      <view class="step-num done">✓</view>
      <text class="step-label done">填写地址</text>
    </view>
    <view class="step-line done"></view>
    <view class="step done">
      <view class="step-num done">✓</view>
      <text class="step-label done">物品信息</text>
    </view>
    <view class="step-line done"></view>
    <view class="step active">
      <view class="step-num active">3</view>
      <text class="step-label active">选择车型</text>
    </view>
  </view>

  <view class="tabs">
    <view
      class="tab {{activeTab === 'recommended' ? 'active' : ''}}"
      data-tab="recommended"
      bindtap="onTabChange"
    >推荐</view>
    <view
      class="tab {{activeTab === 'nearest' ? 'active' : ''}}"
      data-tab="nearest"
      bindtap="onTabChange"
    >最近</view>
    <view
      class="tab {{activeTab === 'all' ? 'active' : ''}}"
      data-tab="all"
      bindtap="onTabChange"
    >全部</view>
  </view>

  <view class="sub-tip">
    <text class="dot"></text>
    <text>按照货物参数匹配车型，优先展示适合当前货物的车辆</text>
  </view>

  <view class="model-list">
    <view
      class="model-card press-scale {{selectedModelId === item.modelId ? 'selected' : ''}} {{!item.available ? 'needs-review' : ''}}"
      hover-class="model-card-hover"
      wx:for="{{visibleOffers}}"
      wx:key="modelId"
      data-id="{{item.modelId}}"
      bindtap="onSelect"
    >
      <view class="best-tag" wx:if="{{item.recommended}}">最推荐</view>
      <view class="model-head">
        <image class="model-image" src="{{item.modelImage}}" mode="aspectFit" data-id="{{item.modelId}}" catchtap="onImageTap" />
        <view class="model-info">
          <view class="model-name">{{item.modelName}}</view>
          <view class="quick-metrics">
            <view class="quick-metric"><text>载重</text><text class="quick-value">{{item.maxLoadGrams / 1000}} kg</text></view>
            <view class="quick-metric"><text>容积</text><text class="quick-value">{{fmt.volume(item.cargoVolumeLiters)}}</text></view>
          </view>
          <view class="dimension-row">
            <text>长×宽×高</text>
            <text class="dimension-value" wx:if="{{item.cargoBoxDimensionsMm}}">{{item.cargoBoxDimensionsMm.length / 1000}}×{{item.cargoBoxDimensionsMm.width / 1000}}×{{item.cargoBoxDimensionsMm.height / 1000}} m</text>
            <text class="dimension-value" wx:else>暂无尺寸</text>
          </view>
        </view>
        <view class="model-radio {{selectedModelId === item.modelId ? 'on' : ''}}"></view>
      </view>

      <scroll-view class="model-tags" scroll-x="true" show-scrollbar="false">
        <view class="tag-track">
          <text class="fit-label {{!item.available ? 'warning' : ''}}">{{item.available ? '适合当前货物' : '需核实适配'}}</text>
          <text class="source-tag {{item.supplySource === 'headquarters' ? 'hq' : ''}}">{{item.supplySource === 'headquarters' ? '平台调度' : '附近车辆'}}</text>
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </scroll-view>

      <view class="model-footer" wx:if="{{item.supplySource === 'nearby'}}">
        <text class="footer-item">电量 {{item.batteryPercent === undefined ? '—' : item.batteryPercent + '%'}}</text>
        <text class="footer-item">距离 {{fmt.distance(item.distanceMeters)}}</text>
        <text class="footer-item">约 {{item.estimatedArrivalMinutes}} 分钟到达</text>
      </view>
      <view class="model-footer hq-footer" wx:else>需平台调度确认后安排车辆</view>

    </view>
  </view>

  <empty-state wx:if="{{visibleOffers.length === 0}}" image="/assets/images/empty-vehicles.png" title="暂无推荐车型" desc="可切换到全部车型查看，由平台确认适配情况" />

  <view class="selected-bar" wx:if="{{selected}}">
    <view class="bar-thumb">
      <image class="bar-image" src="{{selected.modelImage}}" mode="aspectFit" />
    </view>
    <view class="bar-info">
      <view class="bar-line">已选择：{{selected.modelName}}</view>
      <view class="bar-eta" wx:if="{{selected.supplySource === 'headquarters'}}">需调度确认</view>
      <view class="bar-eta" wx:else>预计 <text class="text-primary">{{selected.estimatedArrivalMinutes}}</text> 分钟到达</view>
    </view>
    <button class="btn-primary bar-btn" bindtap="onConfirm">确认下单</button>
  </view>
</view>
