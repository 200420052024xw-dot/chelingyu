.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.stepper {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ECEFF3;
  color: var(--color-text-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.step-num.active {
  background: var(--color-primary);
  color: #fff;
}

.step-num.done {
  background: var(--color-primary);
  color: #fff;
}

.step-label {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.step-label.active {
  color: var(--color-primary-deep);
  font-weight: 600;
}

.step-label.done {
  color: var(--color-primary-deep);
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #ECEFF3;
  margin: 0 16rpx;
  margin-bottom: 28rpx;
}

.step-line.done {
  background: var(--color-primary);
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--font-body);
  color: var(--color-text-muted);
  font-weight: 600;
  position: relative;
}

.tab.active {
  color: var(--color-primary-deep);
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.sub-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-bottom: 24rpx;
}

.sub-tip .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.model-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.model-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-card);
  position: relative;
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out),
              border-color var(--motion-fast) var(--ease-out);
}

.model-card-hover {
  transform: scale(0.99);
  box-shadow: var(--shadow-elev);
}

.model-card.selected {
  border-color: var(--color-primary);
  background: linear-gradient(180deg, rgba(15, 185, 109, 0.04) 0%, #fff 60%);
}

.model-card.needs-review { border-color: #F4DDB9; }

.best-tag {
  position: absolute;
  top: 0;
  left: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-caption);
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
  font-weight: 600;
}

.model-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.model-image {
  width: 166rpx;
  height: 166rpx;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  flex-shrink: 0;
}
.fit-label { font-size: 21rpx; color: var(--color-primary-deep); font-weight: 600; white-space: nowrap; }
.fit-label.warning { color: #AA6B22; }
.source-tag { font-size: 20rpx; color: #087B55; background: #E9F7EF; border-radius: 999rpx; padding: 4rpx 12rpx; white-space: nowrap; }
.source-tag.hq { color: #87612D; background: #FFF3E2; }

.model-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.model-name {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-strong);
}

.quick-metrics { display: flex; gap: 14rpx; flex-wrap: wrap; }
.quick-metric { display: flex; gap: 6rpx; align-items: baseline; font-size: 22rpx; color: var(--color-text-muted); white-space: nowrap; }
.quick-value { color: var(--color-text-strong); font-weight: 700; }
.dimension-row { display: flex; align-items: baseline; gap: 10rpx; font-size: 21rpx; color: var(--color-text-muted); white-space: nowrap; }
.dimension-value { color: var(--color-text-strong); font-size: 22rpx; font-weight: 600; }

.model-tags {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}
.tag-track { display: inline-flex; align-items: center; gap: 10rpx; white-space: nowrap; }

.tag {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-caption);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.model-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8DEE5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 8rpx;
}

.model-radio.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.model-radio.on::after {
  content: '';
  width: 12rpx;
  height: 6rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg) translate(0, -2rpx);
}

.model-footer {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-divider);
}
.hq-footer { color: #87612D; font-size: var(--font-caption); }

.footer-item {
  font-size: 21rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* 底部固定栏 */
.selected-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(40rpx + var(--safe-bottom));
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: var(--shadow-elev);
}

.bar-thumb {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-surface-soft);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-image {
  width: 64rpx;
  height: 64rpx;
}

.bar-info {
  flex: 1;
}

.bar-line {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.bar-eta {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  font-weight: 600;
  margin-top: 4rpx;
}

.bar-btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--font-body);
}
