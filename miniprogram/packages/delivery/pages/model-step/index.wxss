.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(180rpx + var(--safe-bottom));
}

.stepper {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ECEFF3;
  color: var(--color-text-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.step-num.active {
  background: var(--color-primary);
  color: #fff;
}

.step-num.done {
  background: var(--color-primary);
  color: #fff;
}

.step-label {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.step-label.active {
  color: var(--color-primary-deep);
  font-weight: 600;
}

.step-label.done {
  color: var(--color-primary-deep);
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #ECEFF3;
  margin: 0 16rpx;
  margin-bottom: 28rpx;
}

.step-line.done {
  background: var(--color-primary);
}

.tip {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-caption);
  margin-bottom: 24rpx;
}

.tip-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--font-body);
  color: var(--color-text-muted);
  font-weight: 600;
  position: relative;
}

.tab.active {
  color: var(--color-primary-deep);
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.sub-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  margin-bottom: 24rpx;
}

.sub-tip .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-card);
  position: relative;
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out),
              border-color var(--motion-fast) var(--ease-out);
}

.model-card-hover {
  transform: scale(0.99);
  box-shadow: var(--shadow-elev);
}

.model-card.selected {
  border-color: var(--color-primary);
  background: linear-gradient(180deg, rgba(15, 185, 109, 0.04) 0%, #fff 60%);
}

.model-card.disabled {
  opacity: 0.6;
}

.best-tag {
  position: absolute;
  top: 0;
  left: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-caption);
  padding: 6rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
  font-weight: 600;
}

.model-head {
  display: flex;
  gap: 16rpx;
}

.model-image {
  width: 144rpx;
  height: 144rpx;
  background: var(--color-surface-soft);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.model-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.model-name {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-strong);
}

.model-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-caption);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.model-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  display: none;
}

.meta-num {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text-strong);
}

.meta-cap {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.model-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8DEE5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.model-radio.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.model-radio.on::after {
  content: '';
  width: 12rpx;
  height: 6rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg) translate(0, -2rpx);
}

.model-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}
.supply-label { width: 100%; padding-bottom: 10rpx; color: #087b55; font-size: 21rpx; font-weight: 600; }
.supply-label.hq { color: #87612d; }

.footer-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.footer-icon {
  width: 24rpx;
  height: 24rpx;
}

.dot-clock {
  color: var(--color-primary);
}

.battery {
  margin-left: auto;
}

.battery-icon {
  position: relative;
  width: 48rpx;
  height: 20rpx;
}

.battery-body {
  width: 40rpx;
  height: 16rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 4rpx;
  padding: 1rpx;
  box-sizing: border-box;
}

.battery-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.battery-cap {
  position: absolute;
  right: 0;
  top: 4rpx;
  width: 6rpx;
  height: 8rpx;
  background: var(--color-primary);
  border-radius: 0 2rpx 2rpx 0;
}

.model-disabled {
  background: #FFF7F4;
  border-radius: 12rpx;
  padding: 12rpx;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.disabled-reason {
  font-size: var(--font-caption);
  color: var(--color-warning);
}

/* 底部固定栏 */
.selected-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(40rpx + var(--safe-bottom));
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: var(--shadow-elev);
}

.bar-thumb {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-surface-soft);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-image {
  width: 64rpx;
  height: 64rpx;
}

.bar-info {
  flex: 1;
}

.bar-line {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.bar-eta {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  font-weight: 600;
  margin-top: 4rpx;
}

.bar-btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--font-body);
}
