.place-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #f5f7f6; }
.search-card { padding: 26rpx; border-radius: 22rpx; background: #fff; }
.field-label { color: #66736f; font-size: 22rpx; }
.city-picker { height: 76rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0ef; color: #24362f; font-size: 28rpx; }
.search-row { display: flex; align-items: center; gap: 14rpx; padding-top: 14rpx; }
.keyword-input { min-width: 0; flex: 1; height: 76rpx; padding: 0 16rpx; border-radius: 12rpx; background: #f5f7f6; font-size: 27rpx; }
.search-btn { width: 140rpx; margin: 0; color: #fff; background: #078f60; font-size: 25rpx; }
.hint { padding: 26rpx 8rpx 12rpx; color: #82908b; font-size: 23rpx; }
.results { border-radius: 18rpx; background: #fff; }
.result { padding: 25rpx 24rpx; border-bottom: 1rpx solid #edf0ef; }
.result-title { color: #1b2924; font-size: 28rpx; font-weight: 600; }
.result-address { margin-top: 8rpx; color: #82908b; font-size: 22rpx; }
.native-btn { position: fixed; right: 28rpx; bottom: 40rpx; left: 28rpx; color: #078f60; border: 1rpx solid #078f60; background: #fff; font-size: 27rpx; }
