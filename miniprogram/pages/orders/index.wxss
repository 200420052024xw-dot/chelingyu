.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 0;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--color-divider);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: var(--font-body);
  color: var(--color-text-muted);
  padding: 16rpx 0;
  position: relative;
  font-weight: 500;
}

.tab.active {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.order-list {
  padding: 16rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out);
}

.order-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-elev);
  background: var(--color-primary-tint);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  font-family: monospace;
}

.order-route {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}

.route-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-pickup { background: var(--color-pickup); }
.dot-dropoff { background: var(--color-dropoff); }

.route-line {
  flex: 1;
  height: 2rpx;
  border-top: 2rpx dashed var(--color-divider);
  margin: 0 8rpx;
}

.route-name {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  font-weight: 500;
}

.order-info {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
}

.info-key {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.info-time {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}

.order-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.amount-label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.amount-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}
