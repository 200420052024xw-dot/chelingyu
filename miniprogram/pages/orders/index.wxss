.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding: 0;
}

.tabs {
  display: block;
  background: #fff;
  padding: 16rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--color-divider);
}
.tabs-inner { display: flex; width: 100%; }

.tab {
  flex: none;
  flex: 1;
  text-align: center;
  font-size: var(--font-body);
  color: var(--color-text-muted);
  padding: 16rpx 0;
  position: relative;
  font-weight: 500;
}

.tab.active {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.order-list {
  padding: 16rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-fast) var(--ease-out),
              box-shadow var(--motion-fast) var(--ease-out);
}

.order-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-elev);
  background: var(--color-primary-tint);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  font-family: monospace;
}

.order-route {
  margin: 22rpx 0;
  padding: 18rpx;
  background: #f7faf8;
  border-radius: 18rpx;
}
.route-node { display: flex; align-items: flex-start; gap: 18rpx; }
.route-node > view:last-child { min-width: 0; flex: 1; }
.route-label { font-size: 22rpx; font-weight: 700; color: #537364; margin-bottom: 4rpx; }
.route-detail { font-size: 23rpx; color: var(--color-text-muted); margin-top: 3rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.route-connector { width: 2rpx; height: 22rpx; border-left: 2rpx dashed #a7c3b2; margin: 5rpx 0 5rpx 7rpx; }

.route-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-pickup { background: var(--color-pickup); }
.dot-dropoff { background: var(--color-dropoff); }

.route-name {
  font-size: var(--font-body);
  color: var(--color-text-strong);
  font-weight: 500;
}

.order-info {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
}

.info-key {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.info-time {
  font-size: var(--font-caption);
  color: var(--color-text-subtle);
}

.order-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.amount-label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.amount-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}
.order-schedule { color: #648575; font-size: 24rpx; margin-top: 14rpx; }
.order-action { border: 0; border-radius: 16rpx; padding: 0 22rpx; height: 64rpx; line-height: 64rpx; background: #e6f7ec; color: #0d9054; font-size: 25rpx; font-weight: 700; margin: 0; }
