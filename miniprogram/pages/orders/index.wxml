<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<view class="page">
  <scroll-view class="tabs" scroll-x="{{true}}" enable-flex="{{true}}">
    <view class="tabs-inner">
    <view
      class="tab {{filter === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="order-list" wx:if="{{list.length > 0}}">
    <view
      class="order-card press-scale"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpenDetail"
    >
      <view class="order-head">
        <view class="order-no">{{item.scheduledLabel}}</view>
        <status-badge text="{{item.statusBadge.text}}" tone="{{item.statusBadge.tone}}" />
      </view>
      <view class="order-route">
        <view class="route-node"><view class="route-dot dot-pickup"></view><view><view class="route-label">寄件地址</view><view class="route-name">{{item.sender}}</view><view class="route-detail">{{item.senderDetail}}</view></view></view>
        <view class="route-connector"></view>
        <view class="route-node"><view class="route-dot dot-dropoff"></view><view><view class="route-label">收件地址</view><view class="route-name">{{item.receiver}}</view><view class="route-detail">{{item.receiverDetail}}</view></view></view>
      </view>
      <view class="order-info">
        <text class="info-key">{{item.vehicleModelName}} · {{item.dispatchSourceLabel}}</text>
        <text class="info-time">单号 {{item.orderNo}}</text>
      </view>
      <view class="order-amount">
        <view><text class="amount-label">订单金额</text><view class="amount-val">{{fmt.money(item.totalAmountFen)}}</view></view>
        <button class="order-action" data-id="{{item.id}}" catchtap="onPrimaryAction">{{item.actionLabel}}</button>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    image="/assets/images/empty-orders.png"
    title="{{filter === 'all' ? '暂无订单' : '该分类暂无订单'}}"
    desc="{{filter === 'all' ? '完成下单后，订单会显示在这里' : '可切换其他分类查看'}}"
  />
</view>
