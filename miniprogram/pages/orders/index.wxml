<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<view class="page">
  <view class="tabs">
    <view
      class="tab {{filter === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view class="order-list" wx:if="{{list.length > 0}}">
    <view
      class="order-card press-scale"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpenDetail"
    >
      <view class="order-head">
        <view class="order-no">订单号 {{item.orderNo}}</view>
        <status-badge text="{{item.statusBadge.text}}" tone="{{item.statusBadge.tone}}" />
      </view>
      <view class="order-route">
        <view class="route-dot dot-pickup"></view>
        <view class="route-name">{{item.sender}}</view>
        <view class="route-line"></view>
        <view class="route-dot dot-dropoff"></view>
        <view class="route-name">{{item.receiver}}</view>
      </view>
      <view class="order-info">
        <text class="info-key">{{item.vehicleModelName}} · {{item.dispatchSourceLabel}}</text>
        <text class="info-time">{{item.createdAt}}</text>
      </view>
      <view class="order-amount">
        <text class="amount-label">订单金额</text>
        <text class="amount-val">{{fmt.money(item.totalAmountFen)}}</text>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    image="/assets/images/empty-orders.png"
    title="{{filter === 'all' ? '暂无订单' : '该分类暂无订单'}}"
    desc="{{filter === 'all' ? '完成下单后，订单会显示在这里' : '可切换其他分类查看'}}"
  />
</view>
