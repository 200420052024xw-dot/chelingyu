<view class="page page-bottom-action">
  <view class="stepper">
    <view class="step active">
      <view class="step-num active">1</view>
      <text class="step-label active">填写地址</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <view class="step-num">2</view>
      <text class="step-label">物品信息</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <view class="step-num">3</view>
      <text class="step-label">选择车型</text>
    </view>
  </view>

  <!-- 寄件地址 -->
  <view class="address-card" bindtap="onPickSender">
    <view class="address-row">
      <view class="address-icon-wrap pickup-icon-wrap">
        <image class="address-icon" src="/assets/icons/tabler/package-export.svg" mode="aspectFit"></image>
      </view>
      <view class="address-info">
        <view class="address-label">寄件地址</view>
        <block wx:if="{{sender}}">
          <view class="address-contact"><text class="contact-name">{{sender.contactName}}</text><text class="contact-phone">{{sender.contactMobile}}</text></view>
          <view class="address-name">{{sender.name}}</view>
          <view class="address-detail">{{sender.detail}}</view>
        </block>
        <view class="address-placeholder" wx:else>从哪里寄出？</view>
      </view>
      <view class="address-action"><text>{{sender ? '更换' : '选择'}}</text><image class="address-action-arrow" src="/assets/icons/tabler/chevron-right.svg" mode="aspectFit"></image></view>
    </view>
  </view>

  <!-- 收件地址 -->
  <view class="address-card" bindtap="onPickReceiver">
    <view class="address-row">
      <view class="address-icon-wrap dropoff-icon-wrap">
        <image class="address-icon" src="/assets/icons/tabler/map-pin.svg" mode="aspectFit"></image>
      </view>
      <view class="address-info">
        <view class="address-label">收件地址</view>
        <block wx:if="{{receiver}}">
          <view class="address-contact"><text class="contact-name">{{receiver.contactName}}</text><text class="contact-phone">{{receiver.contactMobile}}</text></view>
          <view class="address-name">{{receiver.name}}</view>
          <view class="address-detail">{{receiver.detail}}</view>
        </block>
        <view class="address-placeholder" wx:else>送到哪里？</view>
      </view>
      <view class="address-action"><text>{{receiver ? '更换' : '选择'}}</text><image class="address-action-arrow" src="/assets/icons/tabler/chevron-right.svg" mode="aspectFit"></image></view>
    </view>
  </view>


  <!-- 用车时间 -->
  <view class="time-card">
    <view class="time-header">
      <view class="time-header-icon"><image class="time-icon" src="/assets/icons/tabler/clock-hour-4.svg" mode="aspectFit" /></view>
      <text class="time-title">用车时间</text>
    </view>
    <view class="time-modes">
      <view
        class="time-mode {{serviceTimeMode === 'immediate' ? 'active' : ''}}"
        data-mode="immediate"
        bindtap="onSelectTimeMode"
      >
        <image class="time-mode-icon" src="/assets/icons/tabler/truck-delivery.svg" mode="aspectFit"></image>
        <view class="time-mode-name">立即用车</view>
      </view>
      <view
        class="time-mode {{serviceTimeMode === 'scheduled' ? 'active' : ''}}"
        data-mode="scheduled"
        bindtap="onSelectTimeMode"
      >
        <image class="time-mode-icon" src="/assets/icons/tabler/calendar-event.svg" mode="aspectFit"></image>
        <view class="time-mode-name">预约用车</view>
      </view>
    </view>

    <block wx:if="{{serviceTimeMode === 'scheduled'}}">
      <picker mode="date" value="{{scheduledDate}}" start="{{dateMin}}" bindchange="onPickDate" class="time-picker">
        <view class="picker-cell">
          <view class="picker-label-group"><image class="picker-icon" src="/assets/icons/tabler/calendar-event.svg" mode="aspectFit"></image><text class="picker-label">日期</text></view>
          <view class="picker-end"><text class="picker-value">{{scheduledDate || '请选择日期'}}</text><image class="picker-arrow" src="/assets/icons/tabler/chevron-right.svg" mode="aspectFit"></image></view>
        </view>
      </picker>
      <picker mode="multiSelector" range="{{timeColumns}}" value="{{timeSelection}}" bindchange="onPickTime" class="time-picker">
        <view class="picker-cell">
          <view class="picker-label-group"><image class="picker-icon" src="/assets/icons/tabler/clock-hour-4.svg" mode="aspectFit"></image><text class="picker-label">时间</text></view>
          <view class="picker-end"><text class="picker-value">{{scheduledTime || '请选择时间'}}</text><image class="picker-arrow" src="/assets/icons/tabler/chevron-right.svg" mode="aspectFit"></image></view>
        </view>
      </picker>
    </block>

    <block wx:else>
      <view class="time-hint">
        <image class="lightning" src="/assets/icons/tabler/route.svg" mode="aspectFit"></image>
        <text class="hint-text">优先匹配附近共享车辆；如无本地运力，可申请总部调车并先确认运力再支付</text>
      </view>
    </block>
  </view>

  <view class="bottom-action">
    <button class="btn-primary" bindtap="onNext">下一步</button>
  </view>
</view>
