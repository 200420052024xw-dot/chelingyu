# 腾讯位置服务 WebService Key
# 申请：https://lbs.qq.com/ → 控制台 → 应用管理 → 创建应用
# 类型选「微信小程序」 → 勾选「地点检索」「逆地址解析」「距离计算」 → appid 填 wxc96d8acaea5bc77a
# 微信公众平台还需将 apis.map.qq.com 加入小程序 request 合法域名
# 这个文件是示例（不会被加载），复制为 .env 填入真实值：
#   copy .env.example .env  （Windows）
#   cp    .env.example .env  （Mac/Linux）

TENCENT_MAPS_KEY=OB4BZ-D4W3U-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX

# 是否启用 WebService（true=真实距离/路线；false=mock）
USE_TENCENT_MAPS_WEB_SERVICE=true

# WebService 接口域名（一般不用改）
TENCENT_MAPS_API_BASE=https://apis.map.qq.com

# 请求超时（毫秒）
REQUEST_TIMEOUT_MS=8000

# 整体 mock 开关（true 时所有远程接口走本地）
MOCK_MODE=true                                                        
ORDER_API_BASE_URL=http://localhost:3000
ORDER_DEMO_AUTH=true
