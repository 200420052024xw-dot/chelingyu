/**
 * 本地环境配置示例文件 —— 复制为 `env.local.ts` 并填入真实值。
 *
 * 步骤：
 *   1. cp miniprogram/config/env.local.ts.example miniprogram/config/env.local.ts
 *   2. 打开 env.local.ts，把下面的占位符替换成你自己的腾讯地图 key
 *   3. 重启微信开发者工具
 *
 * ⚠ 这个文件本身是示例（不会被加载），真实文件 `env.local.ts` 已被 .gitignore 忽略。
 * ⚠ 严禁把真实 key 提交到 git，也不要写到任何文档/MD 里。
 */

import type { EnvConfig } from "./env";

export const ENV_LOCAL: Partial<EnvConfig> = {
  // 腾讯位置服务 WebService API Key
  // 申请：https://lbs.qq.com/  → 控制台 → 应用管理 → 创建应用 → 应用类型选「微信小程序」
  // → 勾选 WebServiceAPI（地点搜索需要「地点检索」，当前位置名称需要「逆地址解析」）
  // → 微信公众平台把 apis.map.qq.com 加入小程序 request 合法域名
  // → 把 project.config.json 里的 appid (wxc96d8acaea5bc77a) 填进去
  tencentMapsKey: "OB4BZ-D4W3U-****-****-****-****-****-****", // ← 替换成你自己的 key

  // 只有配置真实 key 后才启用 WebService。
  useTencentMapsWebService: false,

  // WebService 接口域名（一般不用改）
  tencentMapsApiBase: "https://apis.map.qq.com",

  // 单次请求超时
  requestTimeoutMs: 8000,

  // 业务数据保存在本机，流程使用模拟数据。
  mockMode: true,
};
